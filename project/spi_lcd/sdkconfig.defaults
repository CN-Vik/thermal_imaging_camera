CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_COLOR_DEPTH_16=y
# ===== 降发热优化（2026-11）=====
# -O2 发行版优化：热成像浮点流水线（中值/双边滤波、双线性放大、gamma）
# 在 -Og 调试优化下要慢 2~4 倍，两个核长期满载是芯片 50℃+ 的根因之一
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 160MHz 已足够 8fps 送显，动态功耗比 240MHz 低约 1/3
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160
# 自动动态电源管理：等待传感器帧的 ~60ms 空闲期进入 light sleep，CPU 功耗从 ~40mA 级降到 ~1mA 级
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# LVGL 内置内存池上限只有 128KB（Kconfig range 2..128），设置页对象 + 横屏旋转缓冲
# 早已吃满：任何后续分配（新建页面/异步回调）都会触发 LV_ASSERT_MALLOC 直接重启。
# 改用自定义分配器（newlib malloc/free -> ESP-IDF 系统堆），内存按需增长，
# 同时省下 128KB 内部 RAM 的静态占用。
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
# LVGL 自带 printf 默认不含 %f 支持，遇到 "%s %.1f %s %d" 这种浮点后面还跟参数的
# 格式串会 va_list 错位，把 double 当 char* 解引用 -> LoadProhibited 重启。
CONFIG_LV_SPRINTF_USE_FLOAT=y
