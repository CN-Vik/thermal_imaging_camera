# 保持性能编译优化，并启用动态调频：计算/显示期间锁定最高频率，传感器等待期间降至80MHz。
# 不降低MLX90640刷新率、不改变滤波或显示算法，保持现有画面效果和帧率。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_PM_ENABLE=y

CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL 内置内存池上限只有 128KB（Kconfig range 2..128），设置页对象 + 横屏旋转缓冲
# 早已吃满：任何后续分配（新建页面/异步回调）都会触发 LV_ASSERT_MALLOC 直接重启。
# 改用自定义分配器（newlib malloc/free -> ESP-IDF 系统堆），内存按需增长，
# 同时省下 128KB 内部 RAM 的静态占用。
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"
# LVGL 自带 printf 默认不含 %f 支持，遇到 "%s %.1f %s %d" 这种浮点后面还跟参数的
# 格式串会 va_list 错位，把 double 当 char* 解引用 -> LoadProhibited 重启。
CONFIG_LV_SPRINTF_USE_FLOAT=y

# Disable application and bootloader logs, and remove the ESP-IDF console UART.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESP_CONSOLE_NONE=y
